# Copy to .env for local dev. In production these are set in the
# Dokploy Environment tab, not committed.

SECRET_KEY=change-me
DEBUG=True
# Prod only: force HTTPS redirect, secure cookies, HSTS. Leave False in dev.
SECURE_HTTPS=False
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=devlaunch_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# Prod only: origin(s) allowed to POST to Django admin over HTTPS,
# e.g. https://api.your-domain.com  (comma-separated, leave blank in dev)
CSRF_TRUSTED_ORIGINS=

# Email — console backend prints to stdout in dev.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=DevLaunch <no-reply@devlaunch.app>

# Payments (placeholders are fine until F5 is built)
STRIPE_SECRET_KEY=placeholder
MPESA_CONSUMER_KEY=placeholder
MPESA_CONSUMER_SECRET=placeholder

# Gunicorn (optional)
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60
